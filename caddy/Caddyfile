{
	# Let's Encrypt / ZeroSSL contact (required for public ACME issuance)
	email {$ACME_EMAIL}
	servers {
		metrics
		trusted_proxies static private_ranges
	}
}

:2019 {
	metrics /metrics
}

(common_security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		-Server
	}
}

{$CADDY_DOMAIN}, localhost, 192.168.122.71 {
	import /etc/caddy/tls.inc

	encode gzip
	import common_security_headers

	@notpanel {
		not path /panel /panel/*
	}
	header @notpanel X-Frame-Options "DENY"
	header @notpanel Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; connect-src 'self' wss: https:; script-src 'self'; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'; base-uri 'self'"

	# API and WebSocket (must be before file_server)
	handle /api/* {
		reverse_proxy backend:8080
	}
	handle /ws {
		reverse_proxy backend:8080
	}
	handle /init_canvas {
		reverse_proxy backend:8080
	}

	handle /panel {
		redir /panel/ permanent
	}
	handle /panel/* {
		header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-eval' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src * data: blob:; connect-src 'self' wss: https:; frame-ancestors 'self'"
		reverse_proxy grafana:3000
	}

	# Prometheus UI is NOT exposed here: it has no built-in auth and would leak
	# metrics and query API to anyone with the URL. Use Grafana (/panel/) or
	# `ssh -L 9090:localhost:9090 user@vm` + `docker compose port prometheus 9090` pattern.

	# Vue SPA + static assets
	handle {
		root * /srv
		# SPA entrypoints: avoid stale HTML that references old hashed bundles (named volume + deploy)
		@spa_html path / /index.html /main /login /register /faculty
		header @spa_html Cache-Control "no-cache, no-store, must-revalidate"
		try_files {path} /index.html
		file_server
	}
}

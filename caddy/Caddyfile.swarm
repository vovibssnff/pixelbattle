{
	# Phase 2 Caddyfile served on the Swarm manager. Round-robins to gateway-1/gateway-2
	# behind the overlay network. See deploy/stack.yml.
	email {$ACME_EMAIL}
	servers {
		metrics
		trusted_proxies static private_ranges
		timeouts {
			idle 120s
		}
	}
}

:2019 {
	metrics /metrics
}

(common_security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		-Server
	}
}

# Include HTTP-only in-cluster aliases so Prometheus blackbox probes match this site.
{$CADDY_DOMAIN}, http://localhost, http://caddy, http://tasks.caddy {
	import /etc/caddy/tls.inc

	encode gzip
	import common_security_headers

	# Blackbox + load-balancer probes; not defined on gateways.
	handle /healthz {
		respond "ok" 200
	}

	@notpanel {
		not path /panel /panel/*
	}
	header @notpanel X-Frame-Options "DENY"
	header @notpanel Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; connect-src 'self' wss: https:; script-src 'self'; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'; base-uri 'self'"

	# Round-robin to both gateway VMs via host-published gateway ports.
	# Sticky-session is NOT required: gateways gossip pixels via Redis Streams
	# (XREADGROUP) + gRPC, so any landing point sees the same canvas.
	handle /api/* {
		reverse_proxy {$GATEWAY_UPSTREAMS} {
			lb_policy round_robin
			lb_try_duration 3s
			health_uri /metrics
			health_interval 5s
		}
	}
	handle /ws {
		reverse_proxy {$GATEWAY_UPSTREAMS} {
			lb_policy round_robin
		}
	}
	handle /init_canvas {
		reverse_proxy {$GATEWAY_UPSTREAMS} {
			lb_policy round_robin
		}
	}

	handle /panel {
		redir /panel/ permanent
	}
	handle /panel/* {
		header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-eval' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src * data: blob:; connect-src 'self' wss: https:; frame-ancestors 'self'"
		reverse_proxy tasks.grafana:3000
	}

	handle {
		root * /srv
		@spa_html path / /index.html /main /login /register /faculty
		header @spa_html Cache-Control "no-cache, no-store, must-revalidate"
		try_files {path} /index.html
		file_server
	}
}

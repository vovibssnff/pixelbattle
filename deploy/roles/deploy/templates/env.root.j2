{{ ansible_managed | comment }}
# Project-root .env consumed by docker compose for variable substitution.
# Mirrors keys in .env.example; values come from group_vars/all/{vars,vault}.yml.

CADDY_DOMAIN={{ caddy_domain }}
ACME_EMAIL={{ acme_email | default('') }}

MONGO_INITDB_ROOT_USERNAME={{ vault_mongo_root_username }}
MONGO_INITDB_ROOT_PASSWORD={{ vault_mongo_root_password }}

REDIS_PASSWORD={{ vault_redis_password }}

GRAFANA_ADMIN_USER={{ vault_grafana_admin_user }}
GRAFANA_ADMIN_PASSWORD={{ vault_grafana_admin_password }}
GRAFANA_ROOT_URL={{ vault_grafana_root_url }}

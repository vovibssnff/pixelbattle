# Default backend env for docker-compose (development). Override with app.env via compose override for production.
# Copy app.env.example to app.env for a customizable local file (gitignored).

REDIS_ADDR=redis:6379
REDIS_PSW=redis
REDIS_HISTORY=0
REDIS_TIMER=1

MONGO_URI=mongodb://root:changeme@mongodb:27017/pixelbattle?authSource=admin

CANVAS_HEIGHT=100
CANVAS_WIDTH=100

API_VERSION=5.131
SERVICE_TOKEN=replace_me

ADMIN_IDS=

# Local username admins (comma-separated, lowercase). Use with password accounts.
ADMIN_USERNAMES=

SESSION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
SESSION_SECURE=true
LOG_LEVEL=info
WS_ALLOW_ANONYMOUS=false

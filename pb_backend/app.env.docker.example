# Default backend env for docker-compose (template).
# Copy to `app.env.docker` (gitignored) and replace CHANGE_ME values, or use compose override.
# Root `.env` must set MONGO/Redis/Grafana secrets; MONGO_URI and REDIS_PSW here must match.

REDIS_ADDR=redis:6379
REDIS_PSW=CHANGE_ME_MUST_MATCH_ROOT_ENV_REDIS_PASSWORD
REDIS_HISTORY=0
REDIS_TIMER=1

PIXEL_COOLDOWN_SEC=3

MONGO_URI=mongodb://root:CHANGE_ME_MUST_MATCH_ROOT_ENV_MONGO_PASSWORD@mongodb:27017/pixelbattle?authSource=admin

CANVAS_HEIGHT=100
CANVAS_WIDTH=100

API_VERSION=5.131
SERVICE_TOKEN=CHANGE_ME_VK_SERVICE_TOKEN

ADMIN_IDS=

# Local username admins (comma-separated, lowercase). Use with password accounts.
ADMIN_USERNAMES=

# Optional static token for /api/admin/* when using header X-Admin-Token (Grafana, scripts).
# Swarm deployments should prefer ADMIN_API_TOKEN_FILE with a Docker secret.
ADMIN_API_TOKEN=
# ADMIN_API_TOKEN_FILE=/run/secrets/admin_api_token

# Generate: openssl rand -hex 32
SESSION_KEY=CHANGE_ME_RUN_OPENSSL_RAND_HEX_32
# SESSION_KEY_FILE=/run/secrets/session_key
SESSION_SECURE=true
LOG_LEVEL=info
WS_ALLOW_ANONYMOUS=false

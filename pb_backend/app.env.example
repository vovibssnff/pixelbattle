# Copy to `app.env` (gitignored) and adjust for your environment.

# Redis (must match .env / REDIS_PASSWORD in docker-compose)
REDIS_ADDR=redis:6379
REDIS_PSW=CHANGE_ME_MUST_MATCH_ROOT_ENV_REDIS_PASSWORD
REDIS_HISTORY=0
REDIS_TIMER=1

# Optional: comma-separated cluster seed addresses (enables redis.ClusterClient for canvas + timer).
# When set, hashtag keys pixel:{y:x} are forced. Example (docker compose profile redis-cluster):
# REDIS_CLUSTER_ADDRS=redis-c1:6379,redis-c2:6379,redis-c3:6379
# REDIS_CLUSTER_ADDRS=

# Optional on standalone: store pixels as pixel:{y:x} (same as cluster; wipes legacy pixel:y:x data if toggled).
REDIS_CANVAS_HASHTAG_KEYS=false

# Seconds between pixel placements per user (Redis key TTL). Example: 1 for fast tests, 3 default.
PIXEL_COOLDOWN_SEC=3

# MongoDB — user:password must match MONGO_INITDB_* in project root .env
# Example: mongodb://root:YOUR_PASSWORD@mongodb:27017/pixelbattle?authSource=admin
MONGO_URI=mongodb://root:CHANGE_ME_MUST_MATCH_ROOT_ENV_MONGO_PASSWORD@mongodb:27017/pixelbattle?authSource=admin

CANVAS_HEIGHT=100
CANVAS_WIDTH=100

# VK Mini App
API_VERSION=5.131
SERVICE_TOKEN=CHANGE_ME_VK_SERVICE_TOKEN

# Comma-separated VK user IDs treated as admins
ADMIN_IDS=

# Comma-separated local usernames (password auth) treated as admins
ADMIN_USERNAMES=

# Optional static token for /api/admin/* when using header X-Admin-Token (Grafana Infinity, scripts).
# Leave empty to rely on session + effective admin only.
ADMIN_API_TOKEN=

# Session signing key — persistent across deploys; 32+ bytes (hex or random string)
# Generate: openssl rand -hex 32
SESSION_KEY=CHANGE_ME_RUN_OPENSSL_RAND_HEX_32

# Cookie Secure flag (true behind HTTPS / Caddy; false only for plain HTTP to backend)
SESSION_SECURE=true

# debug | info | warn | error
LOG_LEVEL=info

# Load tests only — never enable in production
WS_ALLOW_ANONYMOUS=false

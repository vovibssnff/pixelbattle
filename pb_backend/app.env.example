# Copy to app.env (gitignored) and adjust for your environment.

# Redis (must match docker-compose / REDIS_PASSWORD)
REDIS_ADDR=redis:6379
REDIS_PSW=redis
REDIS_HISTORY=0
REDIS_TIMER=1

# MongoDB (use credentials from MONGO_INITDB_* in .env / docker-compose)
MONGO_URI=mongodb://root:changeme@mongodb:27017/pixelbattle?authSource=admin

CANVAS_HEIGHT=100
CANVAS_WIDTH=100

# VK Mini App
API_VERSION=5.131
SERVICE_TOKEN=your_vk_service_token

# Comma-separated VK user IDs treated as admins
ADMIN_IDS=

# Comma-separated local usernames (password auth) treated as admins
ADMIN_USERNAMES=

# Session signing key (32+ bytes strongly recommended). Persistent across deploys.
SESSION_KEY=change_me_to_a_random_string_at_least_32_bytes_long

# Cookie Secure flag (true behind HTTPS / Caddy; false only for plain HTTP to backend)
SESSION_SECURE=true

# debug | info | warn | error
LOG_LEVEL=info

# Load tests only — never enable in production
WS_ALLOW_ANONYMOUS=false

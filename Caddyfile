{
	# Self-signed TLS only; no ACME
	auto_https off
	servers {
		metrics
	}
}

:2019 {
	metrics /metrics
}

:443 {
	tls /etc/caddy/certs/pixelbattle.crt /etc/caddy/certs/pixelbattle.key

	encode gzip

	# API and WebSocket (must be before file_server)
	handle /api/* {
		reverse_proxy backend:8080
	}
	handle /ws {
		reverse_proxy backend:8080
	}
	handle /init_canvas {
		reverse_proxy backend:8080
	}

	# Grafana (preserve /panel prefix; matches GF_SERVER_ROOT_URL)
	handle /panel/* {
		reverse_proxy grafana:3000
	}
	handle /panel {
		redir /panel/ permanent
	}

	# Prometheus UI is NOT exposed here: it has no built-in auth and would leak
	# metrics and query API to anyone with the URL. Use Grafana (/panel/) or
	# `ssh -L 9090:localhost:9090 user@vm` + `docker compose port prometheus 9090` pattern.

	# Vue SPA + static assets
	handle {
		root * /srv
		# SPA entrypoints: avoid stale HTML that references old hashed bundles (named volume + deploy)
		@spa_html path / /index.html /main /login /register /faculty
		header @spa_html Cache-Control "no-cache, no-store, must-revalidate"
		try_files {path} /index.html
		file_server
	}
}

# Optional HTTP redirect to HTTPS
:80 {
	redir https://{host}{uri} permanent
}

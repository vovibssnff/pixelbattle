# Copy to .env in the project root for docker compose variable substitution.
# See also pb_backend/app.env.example

MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=changeme

REDIS_PASSWORD=redis

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
# Public URL of Grafana when served under Caddy (must end with /panel/)
GRAFANA_ROOT_URL=https://localhost/panel/

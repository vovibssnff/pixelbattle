# Copy to `.env` in the project root for docker compose variable substitution.
# All secret values must be set before `docker compose up` (no insecure defaults).
# See also pb_backend/app.env.example and pb_backend/app.env.docker.example

# Redis topology (pick one):
#   COMPOSE_PROFILES=standalone       — single-node Redis (default dev; set REDIS_ADDR=redis:6379 in app.env.docker)
#   COMPOSE_PROFILES=redis-cluster    — 3 masters + bootstrap; set REDIS_CLUSTER_ADDRS in app.env.docker
# You can export this or add to `.env` (Compose reads COMPOSE_PROFILES from the environment).
COMPOSE_PROFILES=standalone

# Caddy — public site name for automatic HTTPS (Lets Encrypt). Must resolve to this host for issuance.
CADDY_DOMAIN=dev.example.com
# Contact for ACME (required in .env for compose; unused if you only use tls internal or file PEMs in caddy/tls.inc)
ACME_EMAIL=you@example.com

# MongoDB — must match MONGO_URI in pb_backend app env
# Generate password: openssl rand -base64 24
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=CHANGE_ME_BEFORE_FIRST_RUN

# Redis — must match REDIS_PSW in pb_backend app env
REDIS_PASSWORD=CHANGE_ME_BEFORE_FIRST_RUN

# Grafana (Caddy /panel/)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_BEFORE_FIRST_RUN
# Public URL of Grafana when served under Caddy (must end with /panel/; host must match CADDY_DOMAIN)
GRAFANA_ROOT_URL=https://dev.example.com/panel/

# Backend admin API: set ADMIN_API_TOKEN in pb_backend/app.env (see pb_backend/app.env.example).
# Optional; used with HTTP header X-Admin-Token for /api/admin/* from Grafana Infinity or scripts.

        "sync": false,
        "update": {
          "code": "const r = context.panel.response;\nif (r && r.ok) {\n  context.grafana.notifySuccess(['Resize', 'Canvas expanded; clients receive RESIZE.']);\n} else if (r) {\n  context.grafana.notifyError(['Resize', 'HTTP ' + r.status]);\n}",
          "confirm": true,
          "contentType": "application/json",
          "getPayload": "const wEl = context.panel.elements.find((e) => e.id === 'width');\nconst hEl = context.panel.elements.find((e) => e.id === 'height');\nconst w = Number(wEl?.value);\nconst h = Number(hEl?.value);\nif (!Number.isFinite(w) || !Number.isFinite(h) || w < 1 || h < 1) {\n  context.grafana.notifyError(['Resize', 'Enter positive width and height.']);\n  throw new Error('validation');\n}\nreturn { width: Math.floor(w), height: Math.floor(h) };",
